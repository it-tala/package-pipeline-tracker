# Copy to .env for local use, or paste these into Vercel → Settings → Environment
# Variables. .env is gitignored; never commit real values.

# ── Auth ──────────────────────────────────────────────────────────────
# Required in production. Leave unset locally and the login gate stays open.
# Anyone who reaches the deployed URL without this can write to your tracker.
APP_PASSWORD=

# Optional. Defaults to APP_PASSWORD. Set it so you can invalidate every existing
# session (by changing this) without also changing the password people type.
SESSION_SECRET=

# ── Google ────────────────────────────────────────────────────────────
# Workload Identity Federation - the deployed path. Key creation is blocked by
# org policy (constraints/iam.disableServiceAccountKeyCreation), so there is no
# secret to store. Vercel injects VERCEL_OIDC_TOKEN at runtime; you set these two.
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_SERVICE_ACCOUNT_EMAIL=capture-worker@john-lau-v01.iam.gserviceaccount.com

# Only for hosts outside this org - cannot be created for john-lau-v01.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Only used on the ADC path (local). Ignored when a service account key is set.
GOOGLE_QUOTA_PROJECT=john-lau-v01

# Override the target spreadsheet if you ever run against a copy.
SHEET_ID=1ngkYK5XJijW5JIfUD14IzxAQHxBYXVSGwa9mGejsOhI
